{
  "version": 3,
  "meta": {"name": "probe_rope", "description": "One rope-skill feasibility scenario, chosen by $PROBE (ab: lay a lobe round a pin and cross over it; c: thread an end under a lifted strand; d: two-hand pull of the tied knot)."},
  "nodes": {
    "probe": {"type": "subgraph", "ref": "probe_sg"},
    "done": {"type": "end", "status": "success"},
    "abort": {"type": "end", "status": "failure"}
  },
  "edges": [["START", "probe"]],
  "conditional_edges": {"probe": {"router_field": "exit", "mapping": {"ok": "done", "failed": "abort"}}},
  "subgraphs": {
    "probe_sg": {
      "skill": "generic", "inputs": {}, "outputs": {},
      "nodes": {
        "layout": {"type": "tool", "tool": "rope.layout", "inputs": {}},
        "scenario": {"type": "script", "script": "scripts/scenario.py", "inputs": {"layout": {"$ref": "layout"}}},
        "ok": {"type": "noop"}
      },
      "edges": [["START", "layout"], ["layout", "scenario"], ["scenario", "ok"], ["ok", "END"]],
      "conditional_edges": {},
      "exit": {"router_field": null, "success_values": ["ok"]},
      "on_error": "failed"
    }
  }
}
