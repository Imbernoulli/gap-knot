{
  "version": 3,
  "meta": {
    "name": "tighten_adaptive_feedback",
    "description": "Measure and retain the initial overhand length; retry settled, grasp-verified pulls with state-based tail selection, stroke, lift and workspace limits."
  },
  "nodes": {
    "assess": {
      "type": "subgraph",
      "ref": "assess_sg"
    },
    "pull": {
      "type": "subgraph",
      "ref": "pull_sg"
    },
    "verify": {
      "type": "subgraph",
      "ref": "verify_sg"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "robot.open_gripper",
          "inputs": {
            "arm_id": 0
          }
        },
        {
          "tool": "robot.open_gripper",
          "inputs": {
            "arm_id": 1
          }
        }
      ]
    }
  },
  "edges": [
    [
      "START",
      "assess"
    ]
  ],
  "conditional_edges": {
    "pull": {
      "router_field": "exit",
      "mapping": {
        "tight": "verify",
        "pulled": "verify",
        "lost": "verify",
        "failed": "abort"
      }
    },
    "verify": {
      "router_field": "exit",
      "mapping": {
        "tight": "done",
        "loose": "abort",
        "failed": "abort",
        "retry": "pull"
      }
    },
    "assess": {
      "router_field": "exit",
      "mapping": {
        "ready": "pull",
        "lost": "abort",
        "failed": "abort"
      }
    }
  },
